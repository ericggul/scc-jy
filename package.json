{
  "name": "scc-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev": "node scripts/dev-https.mjs --all",
    "dev:scc": "node scripts/dev-https.mjs --app scc",
    "dev:c-val": "node scripts/dev-https.mjs --app c-val",
    "dev:ddong-meong": "node scripts/dev-https.mjs --app ddong-meong",
    "dev:next": "node scripts/dev-https.mjs --all",
    "dev:socket": "bash scripts/generate-certs.sh && node socket-server.mjs",
    "dev:socket:scc": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=scc node socket-server.mjs",
    "dev:socket:c-val": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=c-val node socket-server.mjs",
    "dev:socket:ddong-meong": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=ddong-meong node socket-server.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint",
    "audio:c-val": "node scripts/generate-c-val-exclamations.mjs",
    "test:c-val:shake": "node scripts/verify-c-val-shake.mjs --version 2",
    "test:c-val:shake:v1": "node scripts/verify-c-val-shake.mjs --version 1",
    "test:c-val:shake:v2": "node scripts/verify-c-val-shake.mjs --version 2"
  },
  "dependencies": {
    "sharp": "0.34.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "next": "16.2.10",
    "typescript": "^5"
  }
}
